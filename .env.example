# Select one provider: openai, claude, gemini, qwen, deepseek, glm
LLM_PROVIDER=openai
MODELS_CONFIG=models.yml

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/

# Gemini / Google AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Qwen / Alibaba Cloud Model Studio (DASHSCOPE_API_KEY is also accepted)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GLM / Zhipu BigModel (ZAI_API_KEY is also accepted)
GLM_API_KEY=
GLM_MODEL=glm-5.1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

DATABASE_PATH=sample_data/anime_streaming/anime_streaming.sqlite
HISTORY_DB_PATH=.queryforge/history.db

# Integrated Agent Team run state and artifacts.
ORCHESTRATION_STATE_ROOT=.queryforge/runs

# QueryForge requires a validated semantic layer by default. A model beside the
# database is discovered automatically; this explicit path remains useful in
# deployments where data and semantics live in different directories.
REQUIRE_SEMANTIC_MODEL=true
SEMANTIC_MODEL_PATH=sample_data/anime_streaming/semantic_model.yml

# Optional strict SQL AST policy. Base AST write/function/recursive-CTE protection is
# always active; set this for table/column allowlists and LIMIT enforcement.
SQL_SECURITY_POLICY_PATH=

# Standard-library console + file logging
LOG_LEVEL=INFO
LOG_FILE=.queryforge/logs/queryforge.log

# Optional LanceDB vector knowledge base. Embeddings use an OpenAI-compatible endpoint.
VECTOR_KB_PATH=.queryforge/lancedb
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
